{
  "appId": "com.twilightcode.desktop",
  "productName": "TwilightCode",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "icon": "src/renderer/assets/logo.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "TwilightCode"
  },
  "mac": {
    "target": "dmg",
    "icon": "src/renderer/assets/logo.png"
  },
  "linux": {
    "target": "AppImage",
    "icon": "src/renderer/assets/logo.png"
  }
}
